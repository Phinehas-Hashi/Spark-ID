# Appwrite configuration for the existing developer-registration service.
APPWRITE_ENDPOINT=https://YOUR-REGION.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=YOUR_PROJECT_ID
APPWRITE_API_KEY=REPLACE_WITH_SERVER_SIDE_KEY
APPWRITE_DATABASE_ID=spark_id
APPWRITE_APPROVALS_TABLE_ID=developer_approvals
APPWRITE_APPLICATIONS_TABLE_ID=developer_apps
# Local loopback-only read-only server; never commit real credentials.
SPARK_ID_ENABLE_LOCAL_LISTING=false

# Optional Spark ID OIDC staging server. Copy this file to ignored .env and
# replace every placeholder. Keep staging disabled until database and secrets
# are set up and reviewed.
SPARK_ID_OIDC_ENVIRONMENT=staging
SPARK_ID_OIDC_ENABLE_STAGING=false
SPARK_ID_OIDC_ISSUER=https://auth.example.invalid
SPARK_ID_OIDC_CLIENT_ID=replace_with_staging_client_id
SPARK_ID_OIDC_CLIENT_SECRET=
SPARK_ID_OIDC_REDIRECT_URIS=["https://YOUR-STUDIO-PROJECT.supabase.co/auth/v1/callback"]
SPARK_ID_OIDC_JWKS=
SPARK_ID_OIDC_COOKIE_KEYS=

# The host and database name must match DATABASE_URL exactly. Require PostgreSQL TLS.
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_DB_HOST/STAGING_DB_NAME?sslmode=require
SPARK_ID_OIDC_STAGING_DB_HOST=STAGING_DB_HOST
SPARK_ID_OIDC_STAGING_DB_NAME=STAGING_DB_NAME

SPARK_ID_OIDC_TRUSTED_PROXY=true
PORT=10000
